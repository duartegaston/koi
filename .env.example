# Copiar a `.env.local` (para `next dev`) y a `.dev.vars` (para `wrangler pages dev`).
APP_URL=http://localhost:3000

# PostgreSQL. En local puede ser localhost; en producción, la URL del servidor (con sslmode=require).
# Si la contraseña tiene `$`, escapalo como `\$`. Next expande variables al leer este archivo.
DATABASE_URL=postgresql://user:password@localhost:5432/koi

# Número del local, formato internacional y solo dígitos (sin +). El cliente abre wa.me y envía el pedido.
WHATSAPP_NUMBER=5491112345678

# Datos del local. Los radios y el costo de envío siguen en la tabla shipping_zones.
STORE_PICKUP_ADDRESS="Calle y número, Posadas"
STORE_TRANSFER_ALIAS=tu.alias
STORE_ORIGIN_LATITUDE=-27.362100
STORE_ORIGIN_LONGITUDE=-55.900900

# Google Maps. Places API (New) para sugerir calles y Geocoding API para ubicar el envío.
# La misma clave, solo en el servidor. En Google Cloud restringila a esas dos APIs
# y poné un tope de uso. No uses restricción por referrer: el Worker la llama desde el servidor.
GOOGLE_MAPS_API_KEY=

# Mercado Pago. Access Token de Tus integraciones (prueba: empieza con TEST-).
# El secret se muestra al configurar el webhook de pagos.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Admin. Un solo operador. El hash se genera con:
#   node scripts/hash-admin-password.mjs "una clave de al menos 12 caracteres"
# Next expande $ en .env: escapá cada $ del hash como \$.
# En `wrangler secret put` pegá el hash sin barras.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
