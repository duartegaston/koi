# Copiar a `.env.local` (para `next dev`) y a `.dev.vars` (para `wrangler pages dev`).
APP_URL=http://localhost:3000

# Neon: usar la connection string "pooled" (host con -pooler).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Koi <no-reply@tu-dominio.com>"

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=un-token-aleatorio-para-verificar-el-webhook
WHATSAPP_APP_SECRET=
# Opcional: plantilla aprobada que se envía a quien deja su teléfono en el formulario.
WHATSAPP_CONTACT_TEMPLATE=
