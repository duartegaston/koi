# Copiar a `.env.local` (para `next dev`) y a `.dev.vars` (para `wrangler pages dev`).
APP_URL=http://localhost:3000

# PostgreSQL. En local puede ser localhost; en producción, la URL del servidor (con sslmode=require).
DATABASE_URL=postgresql://user:password@localhost:5432/koi

# Resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Koi <no-reply@tu-dominio.com>"

# Número del local, formato internacional y solo dígitos (sin +). El cliente abre wa.me y envía el pedido.
WHATSAPP_NUMBER=5491112345678
