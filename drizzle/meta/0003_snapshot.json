        "orders_status_check": {
          "name": "orders_status_check",
          "value": "\"orders\".\"status\" IN ('pending_payment', 'paid', 'cancelled', 'fulfilled')"
        },
        "orders_fulfillment_method_check": {
          "name": "orders_fulfillment_method_check",
          "value": "\"orders\".\"fulfillment_method\" IN ('motorcycle', 'pickup')"
        },
        "orders_payment_method_check": {
          "name": "orders_payment_method_check",
          "value": "\"orders\".\"payment_method\" IN ('mercadopago', 'transfer')"
        },
        "orders_amounts_check": {
          "name": "orders_amounts_check",
          "value": "\"orders\".\"subtotal\" >= 0 AND \"orders\".\"shipping_cost\" >= 0 AND \"orders\".\"total\" >= 0"
        },
        "orders_total_check": {
          "name": "orders_total_check",
          "value": "\"orders\".\"total\" = \"orders\".\"subtotal\" + \"orders\".\"shipping_cost\""
        },
        "orders_motorcycle_posadas_check": {
          "name": "orders_motorcycle_posadas_check",
          "value": "\"orders\".\"fulfillment_method\" <> 'motorcycle' OR (\n        \"orders\".\"city\" = 'Posadas'\n        AND \"orders\".\"province\" = 'Misiones'\n        AND \"orders\".\"address_line\" IS NOT NULL\n        AND \"orders\".\"latitude\" IS NOT NULL\n        AND \"orders\".\"longitude\" IS NOT NULL\n        AND \"orders\".\"distance_km\" IS NOT NULL\n        AND \"orders\".\"shipping_zone_id\" IS NOT NULL\n      )"
        },
        "orders_pickup_check": {
          "name": "orders_pickup_check",
          "value": "\"orders\".\"fulfillment_method\" <> 'pickup' OR (\n        \"orders\".\"shipping_cost\" = 0 AND \"orders\".\"shipping_zone_id\" IS NULL\n      )"
        },
        "orders_coordinates_check": {
          "name": "orders_coordinates_check",
          "value": "(\n        \"orders\".\"latitude\" IS NULL AND \"orders\".\"longitude\" IS NULL\n      ) OR (\n        \"orders\".\"latitude\" BETWEEN -90 AND 90\n        AND \"orders\".\"longitude\" BETWEEN -180 AND 180\n      )"
        },
        "orders_distance_check": {
          "name": "orders_distance_check",
          "value": "\"orders\".\"distance_km\" IS NULL OR \"orders\".\"distance_km\" >= 0"
        }
      },
      "isRLSEnabled": false
    },
